# CareerOrbit AI Environment Variables Template
CAREERORBIT_HOST=127.0.0.1
CAREERORBIT_PORT=8000
CAREERORBIT_DEBUG=False
CAREERORBIT_TIMEZONE=Asia/Kolkata
CAREERORBIT_PRIMARY_ACCOUNT=

JOB_DISCOVERY_TIME=08:00
STUDY_PLAN_TIME=20:00

# Optional external integrations
# GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
# GOOGLE_SHEET_ID=your_sheet_id_here
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Public ATS board feeds (comma-separated Company=board-token entries; no credentials)
# CAREERORBIT_GREENHOUSE_BOARDS=CompanyA=board_token,CompanyB=another_token
# CAREERORBIT_LEVER_SITES=CompanyA=site_slug,CompanyB=another_site

# Telegram Bot Integration (@CareerOrbitJobAssistantBot)
# Obtain token securely from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL=5
# Webhook secret token (optional, for webhook deployments)
# TELEGRAM_WEBHOOK_SECRET=
